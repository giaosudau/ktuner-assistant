# Civic FE Tune Assist — the tuning loop's configuration.
# Copy to `.env` in the repo root (gitignored). Every value has a working default:
# with no key at all the loop still works and every reply is the built-in one.
#
# Any OpenAI-compatible endpoint. The key never leaves the server.
KTA_LLM_BASE_URL=https://tokenharbor.ai/v1
KTA_LLM_API_KEY=
KTA_LLM_MODEL=qwen3.8-flash:free
# Comma-separated; the eval layers (2 and 3) compare these, on demand only.
KTA_LLM_MODELS=qwen3.8-flash:free

# Where SQLite lives. Relative paths are read against the repo root.
KTA_DB=server/ktuner.db

# The Node worker (server/kta_worker/worker.js). Change only if `node` is not on PATH.
KTA_NODE=node

# The chat's own port (Next.js reads this when it calls /agent).
KTA_AGENT_URL=http://127.0.0.1:8000/agent