  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Accent pill for the one action a card asks for (e.g. I flashed it).",
      "html": "<button class=\"ds-btn ds-btn-primary\">I flashed it</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:40px;padding:0 16px;border-radius:999px;border:1px solid transparent;background:var(--ink);color:var(--bg);font:600 14px var(--font);cursor:pointer;transition:opacity .15s,background .15s}.ds-btn:hover{opacity:.88}.ds-btn:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-btn-primary{background:var(--accent);color:var(--accent-ink)}"
    },
    {
      "name": "Ghost Button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Secondary action beside a primary.",
      "html": "<button class=\"ds-btn-ghost\">Not yet</button>",
      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;min-height:40px;padding:0 16px;border-radius:999px;border:1px solid var(--line-2);background:transparent;color:var(--ink);font:600 14px var(--font);cursor:pointer;transition:background .15s}.ds-btn-ghost:hover{background:var(--bg-soft)}.ds-btn-ghost:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Composer",
      "kind": "input",
      "refersTo": "composer",
      "description": "The pill composer: textarea above, attach left, send right. The only floating object.",
      "html": "<div class=\"ds-composer\"><textarea rows=\"1\" placeholder=\"Message KTuner Assistant...\"></textarea><div class=\"ds-row\"><button class=\"ds-round\" aria-label=\"Attach\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 5v14M5 12h14\"/></svg></button><span class=\"ds-hint\">Attach a TunerView CSV</span><span class=\"ds-sp\"></span><button class=\"ds-send\" aria-label=\"Send\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 19V5M5 12l7-7 7 7\"/></svg></button></div></div>",
      "css": ".ds-composer{max-width:728px;background:var(--bg-soft);border-radius:26px;box-shadow:var(--shadow-composer);padding:10px 10px 10px 12px;display:flex;flex-direction:column;gap:6px;transition:box-shadow .15s}.ds-composer:focus-within{box-shadow:var(--shadow-composer),0 0 0 1px var(--line-2)}.ds-composer textarea{border:0;outline:0;resize:none;background:transparent;padding:6px 6px 2px;font:16px/1.5 var(--font);color:var(--ink)}.ds-composer textarea::placeholder{color:var(--ink-3)}.ds-row{display:flex;align-items:center;gap:6px}.ds-sp{flex:1}.ds-hint{font-size:12.5px;color:var(--ink-3);font-family:var(--font)}.ds-composer svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-round,.ds-send{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;cursor:pointer}.ds-round{border:1px solid var(--line-2);background:transparent;color:var(--ink-2)}.ds-round:hover{background:var(--bg-hover);color:var(--ink)}.ds-send{border:0;background:var(--accent);color:var(--accent-ink);transition:transform .15s}.ds-send:active{transform:scale(.94)}.ds-round:focus-visible,.ds-send:focus-visible{outline:2px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Suggestion Chip",
      "kind": "chip",
      "refersTo": "chip",
      "description": "Pill suggestions under the composer and after a turn; answer options in the ask card.",
      "html": "<div class=\"ds-chips\"><button class=\"ds-chip\">Why this step?</button><button class=\"ds-chip ds-on\">Stock housing</button></div>",
      "css": ".ds-chips{display:flex;flex-wrap:wrap;gap:8px}.ds-chip{display:inline-flex;align-items:center;min-height:38px;padding:0 14px;border:1px solid var(--line-2);border-radius:999px;background:transparent;font:14px var(--font);color:var(--ink-2);cursor:pointer;transition:background .15s,border-color .15s}.ds-chip:hover{background:var(--bg-soft);color:var(--ink)}.ds-chip:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-on{border-color:var(--accent);background:var(--accent-soft);color:var(--ink)}"
    },
    {
      "name": "Verdict Pill",
      "kind": "chip",
      "refersTo": "pill-good",
      "description": "The only place verdict colours appear as a status; always carries its word.",
      "html": "<span class=\"ds-pill ds-good\">Healthy</span> <span class=\"ds-pill ds-watch\">Waiting for you</span> <span class=\"ds-pill ds-stop\">Stop</span> <span class=\"ds-pill ds-none\">Can't tell yet</span>",
      "css": ".ds-pill{display:inline-flex;align-items:center;gap:6px;height:22px;padding:0 9px;border-radius:999px;font:600 12.5px var(--font);white-space:nowrap}.ds-pill::before{content:'';width:6px;height:6px;border-radius:50%;background:currentColor}.ds-good{color:var(--ok);background:var(--ok-soft)}.ds-watch{color:var(--watch);background:var(--watch-soft)}.ds-stop{color:var(--stop);background:var(--stop-soft)}.ds-none{color:var(--none);background:var(--none-soft)}"
    },
    {
      "name": "Card",
      "kind": "card",
      "refersTo": "card",
      "description": "Generative-UI card inside an assistant turn: hairline, 12px, no shadow.",
      "html": "<section class=\"ds-card\"><div class=\"ds-card-h\"><svg viewBox=\"0 0 24 24\"><path d=\"M13 2L4 14h7l-1 8 9-12h-7z\"/></svg><span class=\"ds-grow\">Next step</span><span class=\"ds-pill-n\">Flash</span></div><p>Put the map from before back on the car.</p><div class=\"ds-proves\"><b>Your next upload proves:</b> trims back within <span class=\"ds-num\">±5 %</span>.</div></section>",
      "css": ".ds-card{border:1px solid var(--line);border-radius:12px;background:var(--bg-raised);padding:14px 16px;font:14px/1.5 var(--font);color:var(--ink)}.ds-card p{margin:0}.ds-card-h{display:flex;align-items:center;gap:8px;margin:0 0 10px;font-weight:600}.ds-card-h svg{width:16px;height:16px;fill:none;stroke:var(--ink-3);stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-grow{flex:1}.ds-pill-n{display:inline-flex;height:22px;align-items:center;padding:0 9px;border-radius:999px;font-size:12.5px;color:var(--none);background:var(--none-soft)}.ds-proves{margin-top:14px;padding-top:12px;border-top:1px solid var(--line);color:var(--ink-2)}.ds-proves b{color:var(--ink)}.ds-num{font-family:var(--mono);font-variant-numeric:tabular-nums}"
    },
    {
      "name": "Sidebar Navigation",
      "kind": "nav",
      "refersTo": "side-item",
      "description": "Sidebar rows, sentence-case group heading and the journey stepper.",
      "html": "<nav class=\"ds-side\"><button class=\"ds-item\"><svg viewBox=\"0 0 24 24\"><path d=\"M12 20h9M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z\"/></svg>New chat</button><div class=\"ds-h\">Tuning journey</div><ol class=\"ds-j\"><li class=\"ds-done\"><span class=\"ds-dot\"></span>Your car</li><li class=\"ds-now\"><span class=\"ds-dot\"></span>Baseline log</li><li><span class=\"ds-dot\"></span>Read &amp; decide</li></ol></nav>",
      "css": ".ds-side{width:260px;background:var(--bg-side);padding:8px;font:14px var(--font);color:var(--ink)}.ds-item{display:flex;align-items:center;gap:10px;width:100%;min-height:38px;padding:0 10px;border:0;border-radius:8px;background:transparent;color:inherit;font:inherit;cursor:pointer}.ds-item:hover{background:var(--bg-hover)}.ds-item:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.ds-item svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round}.ds-h{margin:18px 10px 6px;font-size:12px;font-weight:600;color:var(--ink-3)}.ds-j{list-style:none;margin:0;padding:0 10px}.ds-j li{display:flex;gap:10px;align-items:center;padding:5px 0;color:var(--ink-3)}.ds-dot{width:15px;height:15px;border-radius:50%;border:1.5px solid var(--line-2);background:var(--bg-side)}.ds-done{color:var(--ink-2)}.ds-done .ds-dot{background:var(--ink-3);border-color:var(--ink-3)}.ds-now{color:var(--ink);font-weight:600}.ds-now .ds-dot{border-color:var(--accent);box-shadow:inset 0 0 0 3px var(--bg-side),inset 0 0 0 8px var(--accent)}"
    },
    {
      "name": "Work Row",
      "kind": "custom",
      "refersTo": null,
      "description": "Signature: shimmering live step line that collapses into a disclosure of tool steps.",
      "html": "<div class=\"ds-live\"><span class=\"ds-spin\"></span><span class=\"ds-shim\">Reading your log…</span></div><details class=\"ds-work\" open><summary>Worked for 1.1 s</summary><ul><li><svg class=\"ds-ok\" viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M5 12l5 5 9-10\"/></svg> Checked fuel trims <code>trims</code><span class=\"ds-ms\">120 ms</span></li></ul></details>",
      "css": ".ds-live,.ds-work{font:14px var(--font);color:var(--ink-3)}.ds-live{display:inline-flex;align-items:center;gap:8px;min-height:30px}.ds-spin{width:14px;height:14px;border:1.6px solid var(--line-2);border-top-color:var(--ink-2);border-radius:50%;animation:ds-spin .8s linear infinite}.ds-shim{background:linear-gradient(90deg,var(--ink-3) 0%,var(--ink-3) 40%,var(--ink) 50%,var(--ink-3) 60%,var(--ink-3) 100%);background-size:250% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:ds-shim 1.8s linear infinite}@keyframes ds-spin{to{transform:rotate(360deg)}}@keyframes ds-shim{from{background-position:100% 0}to{background-position:-150% 0}}.ds-work summary{cursor:pointer;min-height:30px;list-style:none}.ds-work summary:hover{color:var(--ink)}.ds-work ul{margin:6px 0 2px 7px;padding:2px 0 2px 16px;border-left:1px solid var(--line-2);list-style:none;color:var(--ink-2)}.ds-work li{display:flex;gap:8px;align-items:center;min-height:32px}.ds-ok{color:var(--ok)}.ds-work code,.ds-ms{font:12px var(--mono);color:var(--ink-3)}.ds-ms{margin-left:auto}"
    }
  ],
  "narrative": {
    "northStar": "The Familiar Chat",
